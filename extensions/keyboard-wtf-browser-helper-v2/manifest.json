{
  "manifest_version": 3,
  "name": "keyboard.wtf Chrome Helper",
  "description": "Lets Jarvis act in the Chrome tabs you explicitly ask it to control.",
  "version": "2.1.14",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "alarms",
    "webNavigation",
    "tabs",
    "scripting",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "action": {
    "default_title": "keyboard.wtf Chrome Helper"
  }
}
