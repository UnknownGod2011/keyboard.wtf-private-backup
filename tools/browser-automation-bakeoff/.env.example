# Local-only benchmark secrets. Do not commit real values.
# The bake-off harness intentionally ignores Jarvis/main app Gemini keys.
BAKEOFF_GEMINI_API_KEY_01=
BAKEOFF_GEMINI_API_KEY_02=
BAKEOFF_GEMINI_API_KEY_03=

# Optional Browser Use optimized hosted model path.
# If absent, browser-use-native benchmarks skip cleanly.
BROWSER_USE_API_KEY=
BROWSER_USE_AGENT_MODEL=bu-2-0

# Optional hosted Stagehand / Browserbase path:
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
