{
  "name": "keyboard-wtf-browser-automation-bakeoff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Isolated real-browser backend bake-off for keyboard.wtf. Not wired into the app.",
  "scripts": {
    "doctor": "node src/doctor.mjs",
    "run": "node src/benchmark-runner.mjs",
    "run:stagehand": "node src/benchmark-runner.mjs --backend stagehand",
    "run:playwright-mcp": "node src/benchmark-runner.mjs --backend playwright-mcp",
    "report": "node src/result-reporter.mjs"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "^3.6.0",
    "@google/genai": "^2.10.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@playwright/mcp": "^0.0.77",
    "dotenv": "^17.2.3",
    "playwright": "^1.57.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {}
}

